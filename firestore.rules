rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function leaderPath(email) {
      return /databases/$(database)/documents/leaders/$(email);
    }
    function setupPath() {
      return /databases/$(database)/documents/meta/setup;
    }
    function isLeader() {
      return signedIn() && exists(leaderPath(myEmail()));
    }
    function meDoc() {
      return get(leaderPath(myEmail())).data;
    }
    function isAdmin() {
      return isLeader() && meDoc().get('admin', false) == true;
    }
    function canRoom(room) {
      return isAdmin() || (isLeader() && room in meDoc().get('rooms', []));
    }
    function roomOf(data) {
      return data.get('roomId', '');
    }
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(setupPath()) && request.resource.data.owner == myEmail() && existsAfter(leaderPath(myEmail()));
    }
    match /usernames/{username} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    match /leaders/{email} {
      allow read: if (signedIn() && email == myEmail()) || isLeader();
      allow create: if signedIn() && email == myEmail() && !exists(setupPath()) && getAfter(setupPath()).data.owner == myEmail() && request.resource.data.admin == true;
      allow create, update, delete: if isAdmin() && email != myEmail();
      allow update: if isAdmin() && email == myEmail() && request.resource.data.admin == true;
    }
    match /locations/{id} {
      allow read: if isLeader();
      allow write: if isAdmin();
    }
    match /rooms/{id} {
      allow read: if isLeader();
      allow write: if isAdmin();
    }
    match /people/{id} {
      allow read: if canRoom(roomOf(resource.data));
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if canRoom(roomOf(resource.data));
      allow write: if isAdmin();
    }
    match /entries/{id} {
      allow read: if canRoom(roomOf(resource.data));
      allow create: if canRoom(roomOf(request.resource.data));
      allow update: if canRoom(roomOf(resource.data)) && canRoom(roomOf(request.resource.data));
      allow delete: if canRoom(roomOf(resource.data));
    }
    match /attendance/{id} {
      allow read: if canRoom(roomOf(resource.data));
      allow create: if canRoom(roomOf(request.resource.data));
      allow update: if canRoom(roomOf(resource.data)) && canRoom(roomOf(request.resource.data));
      allow delete: if canRoom(roomOf(resource.data));
    }
    match /settings/{id} {
      allow read: if isLeader();
      allow write: if isAdmin();
    }
  }
}
